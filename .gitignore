# ===== Entornos virtuales =====
# Ninguno se versiona: `.venv-wsl` sola pesa 2.6 GB, y las dependencias ya estan
# declaradas en requirements.txt. Se reconstruye, no se copia.
.venv*/
~/.venv-ue6/
venv/
env/
ENV/
.python-version
pip-wheel-metadata/

# ===== PyCharm / IDEs =====
.idea/
.vscode/
*.iml

# ===== Datos (NUNCA versionar: datos de menores de edad) =====
# Calificaciones y asistencia de estudiantes = datos sensibles.
# Mantener SOLO en F: y en data/ local. Jamas subir a git.
data/
*.xlsb
*.xlsx
*.xls
*.csv
*.parquet
*.feather
# Temporales de Excel
~$*
*.tmp

# ===== Modelos entrenados / artefactos =====
# El modelo NO viaja por git: es binario, pesa, cambia entero en cada
# entrenamiento y se reconstruye con `python -m ue6_ia.cli` desde los registros.
# En otra maquina se entrena; lo que se versiona es como entrenarlo.
models/
*.keras
*.h5
*.pb
saved_model/
*.tfdf
checkpoints/

# ===== Logs y reportes generados =====
logs/
reports/figures/
mlruns/
*.log

# ===== Notebooks =====
.ipynb_checkpoints/


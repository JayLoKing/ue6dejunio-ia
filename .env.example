# Copiar a .env y ajustar. El .env real no se versiona: lleva el token.
#
#   cp .env.example .env

# Ruta a los registros Excel. En WSL2 los discos de Windows se montan en /mnt/,
# asi que D:\... se escribe /mnt/d/...
# Adentro tienen que estar las carpetas 'REGISTROS DE AÑOS PASADOS' y
# 'Registros 2026' que nombra config/config.yaml.
UE6_DATA_ROOT=/mnt/d/ruta/a/DOCS docentes

# Donde se guarda el modelo entrenado. No se versiona: se entrena en cada maquina.
UE6_MODELS_DIR=./models

# Nivel de log: DEBUG | INFO | WARNING | ERROR
UE6_LOG_LEVEL=INFO

# Servicio de inferencia que consume la API Spring Boot.
#
# Loopback, no 0.0.0.0. Esto sirve calificaciones y asistencia de menores, y sólo
# lo llama Spring. Con 0.0.0.0 el servicio escucha en todas las interfaces de la
# maquina: en una red de escuela con wifi de visitas, eso es exponerlo a cualquiera
# que este en la misma red. Si Spring corre en otra maquina, poner aca la IP
# interna concreta de esta — nunca 0.0.0.0, y nunca de cara a internet.
UE6_API_HOST=127.0.0.1
UE6_API_PORT=8001

# Token compartido con ue6dejunio-api: el MISMO valor va en PREDICTION_TOKEN del
# .env de aquel repo. Es lo unico que separa al modelo de cualquiera que alcance
# el puerto, asi que no dejar este placeholder.
#
# Generar uno propio:
#
#   openssl rand -base64 32
#
# Sin token configurado el servicio responde 503 y no atiende, a proposito: un
# valor por defecto en el repo es un secreto publico.
UE6_API_TOKEN=cambia-este-token

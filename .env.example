# Copiar a .env y ajustar. El .env real no se versiona: lleva el token.
#
#   cp .env.example .env

# Ruta a los registros Excel. En WSL2 los discos de Windows se montan en /mnt/,
# asi que D:\... se escribe /mnt/d/...
# Adentro tienen que estar las carpetas 'REGISTROS DE AÑOS PASADOS' y
# 'Registros 2026' que nombra config/config.yaml.
UE6_DATA_ROOT=/mnt/d/ruta/a/DOCS docentes

# Donde se guarda el modelo entrenado. No se versiona: se entrena en cada maquina.
UE6_MODELS_DIR=./models

# Nivel de log: DEBUG | INFO | WARNING | ERROR
UE6_LOG_LEVEL=INFO

# Servicio de inferencia que consume la API Spring Boot.
UE6_API_HOST=0.0.0.0
UE6_API_PORT=8001

# Token compartido con ue6dejunio-api. Cambiarlo: este valor es un placeholder y
# el servicio no debe quedar expuesto a internet.
UE6_API_TOKEN=cambia-este-token
